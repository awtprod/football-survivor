// Football Survivor — dedicated Tailscale Service access grant.
//
// Paste the relevant pieces into your tailnet policy file
// (https://login.tailscale.com/admin/acls). This is a REFERENCE snippet, not a
// complete policy file — merge it into what you already have.
//
// Two things are required for a Tailscale Service:
//   1. The HOST node must have a tag (Services require tag-based identity).
//      If openclaw-server isn't tagged yet, own a tag and apply it, e.g.:
//        tailscale up --advertise-tags=tag:server
//   2. A grant that lets you REACH the service at svc:football-survivor.
{
  "tagOwners": {
    // Whoever may assign tag:server to nodes. Adjust to your setup.
    "tag:server": ["autogroup:admin"],
  },

  "grants": [
    // Let tailnet members reach the PWA's dedicated service over HTTPS.
    // Narrow "src" (e.g. to a specific user or group) if you don't want the
    // whole tailnet to have access.
    {
      "src": ["autogroup:member"],
      "dst": ["svc:football-survivor"],
      "ip":  ["tcp:443"],
    },
  ],
}
